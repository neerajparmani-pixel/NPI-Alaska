{
  "name": "npi-alaska",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src server functions scripts tests public spreadsheet-first *.json *.html *.md",
    "format:check": "prettier --check src server functions scripts tests public spreadsheet-first *.json *.html *.md",
    "build:cloudflare": "npm run build && wrangler pages functions build functions --outdir dist/_worker.js --output-routes-path dist/_routes.json --compatibility-date 2026-10-27",
    "preview:cloudflare": "wrangler pages dev dist --port 8788",
    "package": "npm run build:cloudflare && python3 scripts/package.py",
    "package:sample": "python3 scripts/package-sample.py",
    "package:operations": "python3 scripts/package-operations.py",
    "package:three-view": "python3 scripts/package-three-view.py",
    "package:live": "python3 scripts/package-visits-release.py",
    "package:release": "python3 scripts/package-visits-release.py",
    "package:field": "python3 scripts/package-visits-release.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "vite": "^7.3.0",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "heic-to": "^1.6.7",
    "utif": "^3.1.0"
  }
}
